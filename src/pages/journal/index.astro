---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';

const entries = (await getCollection('journal')).sort(
	(a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
);
---

<Layout title="Journal">
	<Nav slot="nav" />

	<ul class="space-y-6">
		{
			entries.map((entry) => (
				<li>
					<a
						href={`/journal/${entry.id}`}
						class="group block rounded-2xl border border-stone-200 bg-stone-50 p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-stone-300 hover:shadow-sm dark:border-stone-800 dark:bg-stone-900/40 dark:hover:border-stone-700"
					>
						<span class="font-serif text-2xl font-semibold transition-colors group-hover:text-accent">
							{entry.data.title}
						</span>
						<p class="mt-2 text-xs font-medium tracking-wide text-stone-500 uppercase dark:text-stone-400">
							{entry.data.publishedDate}
						</p>
						<p class="mt-3 leading-relaxed text-stone-600 dark:text-stone-300">{entry.data.summary}</p>
						{entry.data.tags.length > 0 && (
							<ul class="mt-4 flex flex-wrap gap-2">
								{entry.data.tags.map((tag) => (
									<li class="rounded-full border border-stone-200 px-3 py-1 text-xs text-stone-600 dark:border-stone-700 dark:text-stone-300">
										{tag}
									</li>
								))}
							</ul>
						)}
					</a>
				</li>
			))
		}
	</ul>
	{entries.length === 0 && <p>Nothing here yet.</p>}
</Layout>
